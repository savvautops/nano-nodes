---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="max-w-4xl mx-auto px-4 py-12">
      <h1 class="text-4xl font-bold text-accent mb-8 uppercase tracking-widest border-b-4 border-foreground pb-4 inline-block">Blog //</h1>

      <div class="flex flex-col gap-8">
        {posts.map((post) => (
          <article class="border-2 border-foreground p-6 hover:border-accent hover:-translate-y-1 transition-all duration-75 shadow-[4px_4px_0_0_var(--color-foreground)] hover:shadow-[2px_2px_0_0_var(--color-accent)] bg-background">
            <a href={`/blog/${post.id.replace(/\.(md|mdx)$/, '')}/`} class="block group">
              <h2 class="text-2xl text-foreground group-hover:text-accent mb-2 uppercase tracking-wide">
                {post.data.title}
              </h2>
              <p class="text-muted font-mono text-sm mb-4">
                > <FormattedDate date={post.data.pubDate} />
              </p>
              <p class="text-muted leading-relaxed font-mono">
                {post.data.description}
              </p>
            </a>
          </article>
        ))}
      </div>
    </main>
    <Footer />
  </body>
</html>
